// sing-box 统一测试服务器配置
//
// 用途: 为 fixnet 生态所有项目的协议测试提供单一参考实现。
//       合并了原 singbox_test.json 和 singbox_all_inbounds.json，
//       两个 hysteria2 端口共存（10443 主 / 16802 副），消除端口冲突。
//
// 使用方式:
//   1. zigtester 插件自动启动
//   2. 手动: cd plugins/sing-box && sing-box run -c configs/test_server.json
//   3. API: curl http://127.0.0.1:9090/version 或 curl http://[::1]:9090/version
//
// 双栈: 所有 inbound 统一 listen "::" — Linux 和 macOS 均可同时接受 IPv4/IPv6 连接。
//
// 注意: sing-box Clash API (PUT /configs) 只接受 Clash 格式配置，
//       不支持原生格式热重载。需要切换配置时直接重启 sing-box。
//
// 插件互动架构:
//   local-echo 插件 (TCP :13333, DNS :53)
//     ↑ direct outbound
//   sing-box (本配置 — 10 协议 inbound，双栈 :: 同时支持 IPv4/IPv6)
//     ↑ 各协议
//   测试客户端 (zigbox/zigoutbounds ProtocolClient)
//
// 凭证（仅限本机开发测试，无生产价值）:
//   SS2022 PSK:     cec3oZAgAaBi/F69ALSVgQ==
//   Trojan 密码:     test-password
//   Hysteria2 密码:  test-password / hysteria2-password
//   VMess/VLESS UUID: 387b71a7-15ce-4ee0-a791-ab5a08aaa9dc
//   TUIC 密码:       tuic-password
//   Salamander:      salamander-password
//
// 端口分配:
//   :2080  mixed       — SOCKS5 + HTTP 代理（已含两者，无需独立 socks/http inbound）
//   :5354  direct(UDP) — DNS 转发 → 223.5.5.5:53
//   :8388  shadowsocks — SS 2022 (2022-blake3-aes-128-gcm)
//   :9443  trojan      — Trojan (TLS)
//   :10443 hysteria2   — Hysteria2 (QUIC) 主端口
//   :16800 vmess       — VMess (WebSocket)
//   :16801 vless       — VLESS (TLS+XTLS)
//   :16802 hysteria2   — Hysteria2 (QUIC) 副端口
//   :16803 tuic        — TUIC v5 (QUIC)
//   :16804 hysteria2   — Hysteria2 + Salamander 混淆
//   :16805 vless+ws    — VLESS (TLS+WebSocket)
//   :16806 trojan+ws   — Trojan (TLS+WebSocket)
//   :16807 vless+grpc  — VLESS (TLS+gRPC)
//   :16808 trojan+grpc — Trojan (TLS+gRPC)
//   :16809 shadowtls   — ShadowTLS v3 (cover = local-echo TLS :18443; 解壳后 route override→
//                        127.0.0.1:13333 回显, 供传输层真理源验证; ss 叠加形态按需另配)
//   :16810 shadowtls   — ShadowTLS v3 + SS 叠加 (cover 同上; 解壳后 route→ss-in :8388 解密,
//                        客户端形态 = ss outbound + shadowtls transport)

{
  "log": {
    "level": "warn"
  },

  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": ""
    }
  },

  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 2080
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 5354,
      "network": "udp",
      "override_address": "223.5.5.5",
      "override_port": 53
    },
    {
      "type": "shadowsocks",
      "tag": "ss-in",
      "listen": "::",
      "listen_port": 8388,
      "method": "2022-blake3-aes-128-gcm",
      "password": "cec3oZAgAaBi/F69ALSVgQ=="
    },
    {
      "type": "trojan",
      "tag": "trojan-in",
      "listen": "::",
      "listen_port": 9443,
      "users": [
        {
          "name": "test-user",
          "password": "test-password"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2-in",
      "listen": "::",
      "listen_port": 10443,
      "users": [
        {
          "name": "test-user",
          "password": "test-password"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      }
    },
    {
      "type": "vmess",
      "tag": "vmess-in",
      "listen": "::",
      "listen_port": 16800,
      "users": [
        {
          "name": "test-user",
          "uuid": "387b71a7-15ce-4ee0-a791-ab5a08aaa9dc",
          "alterId": 0
        }
      ]
    },
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": 16801,
      "users": [
        {
          "name": "test-user",
          "uuid": "387b71a7-15ce-4ee0-a791-ab5a08aaa9dc",
          "flow": ""
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2-alt-in",
      "listen": "::",
      "listen_port": 16802,
      "users": [
        {
          "name": "test-user",
          "password": "hysteria2-password"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      }
    },
    {
      "type": "tuic",
      "tag": "tuic-in",
      "listen": "::",
      "listen_port": 16803,
      "users": [
        {
          "name": "test-user",
          "uuid": "387b71a7-15ce-4ee0-a791-ab5a08aaa9dc",
          "password": "tuic-password"
        }
      ],
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2-salamander-in",
      "listen": "::",
      "listen_port": 16804,
      "users": [
        {
          "name": "test-user",
          "password": "hysteria2-password"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      },
      "obfs": {
        "type": "salamander",
        "password": "salamander-password"
      }
    },
    {
      "type": "vless",
      "tag": "vless-ws-in",
      "listen": "::",
      "listen_port": 16805,
      "users": [
        {
          "name": "test-user",
          "uuid": "387b71a7-15ce-4ee0-a791-ab5a08aaa9dc",
          "flow": ""
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      },
      "transport": {
        "type": "ws",
        "path": "/vless-ws"
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-ws-in",
      "listen": "::",
      "listen_port": 16806,
      "users": [
        {
          "name": "test-user",
          "password": "test-password"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      },
      "transport": {
        "type": "ws",
        "path": "/trojan-ws"
      }
    },
    {
      "type": "vless",
      "tag": "vless-grpc-in",
      "listen": "::",
      "listen_port": 16807,
      "users": [
        {
          "name": "test-user",
          "uuid": "387b71a7-15ce-4ee0-a791-ab5a08aaa9dc",
          "flow": ""
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      },
      "transport": {
        "type": "grpc",
        "service_name": "vless-grpc"
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-grpc-in",
      "listen": "::",
      "listen_port": 16808,
      "users": [
        {
          "name": "test-user",
          "password": "test-password"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "certs/localhost.crt",
        "key_path": "certs/localhost.key"
      },
      "transport": {
        "type": "grpc",
        "service_name": "trojan-grpc"
      }
    },
    {
      "type": "shadowtls",
      "tag": "shadowtls-in",
      "listen": "::",
      "listen_port": 16809,
      "version": 3,
      "users": [
        {
          "name": "test-user",
          "password": "shadowtls-password"
        }
      ],
      "handshake": {
        "server": "127.0.0.1",
        "server_port": 18443
      },
      "strict_mode": true
    },
    {
      "type": "shadowtls",
      "tag": "shadowtls-ss-in",
      "listen": "::",
      "listen_port": 16810,
      "version": 3,
      "users": [
        {
          "name": "test-user",
          "password": "shadowtls-password"
        }
      ],
      "handshake": {
        "server": "127.0.0.1",
        "server_port": 18443
      },
      "strict_mode": true
    }
  ],

  "dns": {
    "servers": [
      {"type": "udp", "tag": "real-dns", "server": "127.0.0.1", "server_port": 15353}
    ],
    "final": "real-dns"
  },

  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    }
  ],

  "route": {
    "rules": [
      {
        "inbound": ["shadowtls-in"],
        "outbound": "direct-out",
        "override_address": "127.0.0.1",
        "override_port": 13333
      },
      {
        "inbound": ["shadowtls-ss-in"],
        "outbound": "direct-out",
        "override_address": "127.0.0.1",
        "override_port": 8388
      }
    ],
    "final": "direct-out"
  }
}
